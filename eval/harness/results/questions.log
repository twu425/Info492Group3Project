[queryBids] {"purpose":"Median low-bid unit price for item 390132 in District 2","ms":2,"rowCount":1,"truncated":false,"sql":"WITH p AS (SELECT li.unit_price AS up, ROW_NUMBER() OVER (ORDER BY li.unit_price) AS rn, COUNT(*) OVER () AS n FROM line_items li JOIN contracts c ON c.ea = li.contract_ea WHERE li.item_code = '390132' AND li.bidder_rank = 1 AND c.district = 2 AND li.unit_price IS NOT NULL) SELECT n AS sample_size, AVG(up) AS median_unit_price FROM p WHERE rn IN ((n + 1) / 2, (n + 2) / 2)"}
[queryBids] {"purpose":"Median low-bid unit price for item 390132 in District 2","ms":2,"rowCount":1,"truncated":false,"sql":"WITH p AS (SELECT li.unit_price AS up FROM line_items li JOIN contracts c ON c.ea = li.contract_ea WHERE li.item_code = '390132' AND li.bidder_rank = 1 AND c.district = 2 AND li.unit_price IS NOT NULL), r AS (SELECT up, ROW_NUMBER() OVER (ORDER BY up) AS rn, COUNT(*) OVER () AS cnt FROM p) SELECT cnt AS bids, AVG(up) AS median_unit_price FROM r WHERE rn IN ((cnt + 1) / 2, (cnt + 2) / 2) GROUP BY cnt"}
[queryBids] {"purpose":"Median low-bid unit price for item 390132 in District 2","ms":3,"rowCount":1,"truncated":false,"sql":"WITH x AS (SELECT li.unit_price AS p FROM line_items li JOIN contracts c ON c.ea = li.contract_ea WHERE li.item_code = '390132' AND li.bidder_rank = 1 AND c.district = 2 AND li.unit_price IS NOT NULL ORDER BY li.unit_price), n AS (SELECT COUNT(*) AS cnt FROM x) SELECT (SELECT cnt FROM n) AS n, (SELECT p FROM x LIMIT 1 OFFSET (SELECT (cnt-1)/2 FROM n)) AS lo_mid, (SELECT p FROM x LIMIT 1 OFFSET (SELECT cnt/2 FROM n)) AS hi_mid"}
